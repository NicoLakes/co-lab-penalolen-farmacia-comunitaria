# pnpm dev crea .env.local y genera POSTGRES_PASSWORD automáticamente.
POSTGRES_USER=farmacia
POSTGRES_DB=farmacia
POSTGRES_PASSWORD=
WEB_PORT=5173
API_PORT=3001
POSTGRES_PORT=5432
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025

# Optional pilot authentication. Generate a separate secret with openssl rand -hex 32.
# Local development includes Mailpit (web inbox on MAILPIT_PORT, SMTP on mailpit:1025).
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://127.0.0.1:5173
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM=farmacia@penalolen.local
# SMTP_USER=
# SMTP_PASSWORD=
