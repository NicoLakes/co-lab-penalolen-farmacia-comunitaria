{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "auth:admin": "pnpm --filter @farmacia/database build && node --env-file-if-exists=.env --import=tsx src/modules/auth/admin-cli.ts",
    "typecheck": "pnpm --filter @farmacia/database build && tsc -p tsconfig.test.json",
    "test": "pnpm --filter @farmacia/database build && node --import=tsx --test test/*.test.ts",
    "test:integration": "pnpm --filter @farmacia/database build && node --env-file-if-exists=.env --import=tsx --test test/integration/*.test.ts"
  },
  "dependencies": {
    "@farmacia/database": "workspace:*",
    "better-auth": "1.7.21",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "nodemailer": "10.5.0"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2"
  }
}
