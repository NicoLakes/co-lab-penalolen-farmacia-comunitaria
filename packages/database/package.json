{
  "name": "@farmacia/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": null,
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "browser": null,
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import=tsx --test test/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import=tsx --test test/integration/*.test.ts",
    "db:generate": "node --env-file-if-exists=.env --run drizzle:generate",
    "db:migrate": "node --env-file-if-exists=.env --run drizzle:migrate",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
